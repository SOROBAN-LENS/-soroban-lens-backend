# SorobanLens backend configuration.
# Copy to `.env` for local development. Never commit `.env`.
# All values below are the defaults unless stated otherwise.

# --- Server -----------------------------------------------------------------
# Use 0.0.0.0 inside containers; keep 127.0.0.1 for local development.
SOROBAN_LENS_HOST=127.0.0.1
SOROBAN_LENS_PORT=8080
# Network used when a request does not specify one: mainnet | testnet | futurenet
SOROBAN_LENS_DEFAULT_NETWORK=testnet

# --- Stellar RPC endpoints ----------------------------------------------------
# Testnet defaults to the public SDF endpoint (fine for development, not for
# production traffic). Set to an empty value to disable a network.
STELLAR_RPC_TESTNET_URL=https://soroban-testnet.stellar.org
# Mainnet has no default: use an RPC provider. If the provider puts an API key
# in the URL, keep it here only — the backend never logs or returns full URLs.
# STELLAR_RPC_MAINNET_URL=
# STELLAR_RPC_FUTURENET_URL=
STELLAR_RPC_TIMEOUT_SECS=10

# --- HTTP hardening -----------------------------------------------------------
# Comma-separated list of allowed browser origins. "*" allows any (dev only);
# an empty value disables cross-origin access. Default: the Vite dev server.
SOROBAN_LENS_CORS_ORIGINS=http://localhost:5173
SOROBAN_LENS_MAX_BODY_BYTES=16384
SOROBAN_LENS_REQUEST_TIMEOUT_SECS=30
# Analyze requests per client IP per minute. 0 disables rate limiting.
SOROBAN_LENS_RATE_LIMIT_PER_MINUTE=30

# --- Storage --------------------------------------------------------------------
# Maximum number of analyses kept in memory (oldest evicted first).
SOROBAN_LENS_STORE_CAPACITY=1000

# --- Logging --------------------------------------------------------------------
# pretty | json
SOROBAN_LENS_LOG_FORMAT=pretty
# Standard tracing filter.
RUST_LOG=info,soroban_lens=debug,tower_http=info
